HOST=127.0.0.1
PORT=5000
# Optional: point at an existing 11-table SQLite database (e.g. Database/db/demo.db)
# DATABASE=C:\path\to\demo.db
# Change this for any non-local deployment. Stateless tokens are signed with it.
SECRET_KEY=dsc5003-dev-secret-change-me
# rag = 最强RAG (PDF/URL), legacy = old rules/PDF-verbatim path
EXTRACTION_ENGINE=rag
# Default sibling directory; override if 最强RAG is elsewhere
# RAG_HOME=D:\path\to\最强RAG
RAG_STRICT=0
# 0 = all parameter_def rows; set e.g. 8 to cap cost/latency
RAG_PARAMETER_LIMIT=0
RAG_MAX_PAGES=100
RAG_MAX_CHARS=120000
RAG_MAX_TOKENS=4096
# 最强RAG reads DASHSCOPE_API_KEY from its own .env or the process environment.
# DASHSCOPE_API_KEY=sk-...
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
TOKEN_HOURS=24
MAX_UPLOAD_MB=20
MAX_RETRIES=3
# rules: local deterministic parsing; llm: requires configured API; hybrid: try LLM, fall back to rules
EXTRACTION_MODE=rules
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60
# Optional public website host allowlist; comma-separated, empty permits public hosts subject to robots.txt
URL_ALLOWED_HOSTS=

# PDF raw evidence extraction; legacy restores the previous PDF rules/LLM path.
PDF_EXTRACTION_MODE=verbatim
